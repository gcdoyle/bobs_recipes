<% content_for :title, "Ingredients" %>
<% groups = @ingredients.group_by { |i| index_letter(i.name) } %>

<h1 class="mt-4">Ingredients</h1>
<p class="text-muted"><%= pluralize(@ingredients.size, "ingredient") %></p>

<%= render "letter_bar", letters: groups.keys %>

<% groups.each do |letter, ingredients| %>
  <h2 class="letter-heading" id="letter-<%= letter == "#" ? "num" : letter %>"><%= letter %></h2>
  <ul class="list-unstyled ingredient-columns">
    <% ingredients.each do |ingredient| %>
      <li><%= link_to ingredient.name, ingredient %></li>
    <% end %>
  </ul>
<% end %>
