<div class="field-unit__label">
  <%= f.label "Image Upload" %>
</div>
<div class="field-unit__field">
	<% if field.data.attached? %>
	  <%= image_tag field.data, style: "width:320px" %><br />
    <%= f.file_field field.attribute %>
    <%= link_to "Detach", { action: :detach, id: f.object.to_param },
                data: { turbo_method: :post, turbo_confirm: "Remove this photo?" } %>
  <% else %>
	  <%= f.file_field field.attribute %>
	<% end %>
</div>
