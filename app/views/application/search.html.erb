<% content_for :title, "Search" %>

<div id="search-results">
  <h1 class="mt-4">Search</h1>
  <p><%= pluralize(@recipes.load.size, "recipe") %> matching <strong><%= params[:q] %></strong></p>

  <% if @recipes.any? %>
    <div class="row mt-2">
      <%= render partial: "recipes/card", collection: @recipes, as: :recipe %>
    </div>
  <% else %>
    <p class="text-muted">No recipes match. Try an ingredient, or part of a recipe name.</p>
  <% end %>
</div>
