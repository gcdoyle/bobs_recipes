<%= form_with(model: page.resource, url: [namespace, page.resource], scope: page.resource, local: true, id: "recipe-form", class: "form") do |f| %>
  <% if page.resource.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= t(
          "administrate.form.errors",
          pluralized_errors: pluralize(page.resource.errors.count, t("administrate.form.error")),
          resource_name: display_resource_name(page.resource_name, singular: true)
        ) %>
      </h2>

      <ul>
        <% page.resource.errors.full_messages.each do |message| %>
          <li class="flash-error"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% attributes = page.attributes(controller.action_name).values.flatten.index_by(&:name) %>

  <nav class="nav nav-tabs" role="tablist">
    <% @tab_names.each_with_index do |tab, i| %>
      <a href="#<%= tab %>-tab" role="tab" data-admin-tab="<%= tab %>-tab"
         class="nav-item nav-link<%= " active" if i.zero? %>"><%= tab.humanize %></a>
    <% end %>
  </nav>

  <div class="tab-content">
    <% @tab_content.each_with_index do |(tab, fields), i| %>
      <div class="tab-pane<%= " active" if i.zero? %>" id="<%= tab %>-tab" role="tabpanel">
        <% fields.filter_map { |name| attributes[name] }.each do |attribute| %>
          <div class="field-unit field-unit--<%= attribute.html_class %> field-unit--<%= requireness(attribute) %>">
            <%= render_field attribute, f: f %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= f.submit %>
  </div>
<% end %>
